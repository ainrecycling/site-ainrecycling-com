Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddType text/vcard .vcf

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddCharset UTF-8 .html .css .js .mjs .json .txt .xml .svg .md

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^www\.ainrecycling\.com$ [NC,OR]
RewriteCond %{SERVER_PORT} ^80$
RewriteCond %{HTTP_HOST} (^|\.)ainrecycling\.com$ [NC]
RewriteRule ^(.*)$ https://ainrecycling.com/$1 [R=301,L]
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
RewriteCond %{THE_REQUEST} !\s/+api/
RewriteCond %{HTTP_USER_AGENT} (HTTrack|WebCopier|WebZIP|WebReaper|WebStripper|SiteSnagger|SiteSucker|Teleport|Offline\ Explorer|Cyotek|wget|Scrapy|python-requests|python-urllib|Go-http-client|libwww-perl|zgrab) [NC]
RewriteRule ^ - [F,L]
RewriteCond %{HTTP_HOST} ^ainrecycling\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:de/|en/|it/|es/)?)index\.html[\s?]
RewriteRule ^ https://ainrecycling.com/%1 [R=301,L]
RewriteCond %{HTTP_HOST} ^ainrecycling\.com$ [NC]
RewriteRule ^(de|en|it|es)$ https://ainrecycling.com/$1/ [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/.prix-change -f
RewriteRule ^((?:de/|en/|it/|es/)?[a-z0-9-]+\.html)$ serveur/page.php?f=$1 [L]
RewriteCond %{DOCUMENT_ROOT}/.prix-change -f
RewriteRule ^((?:de/|en/|it/|es/)?)$ serveur/page.php?f=$1index.html [L]
RewriteRule ^api/espace/(.*)$ serveur/espace.php?chemin=$1 [QSA,L]
RewriteRule ^api/gestion/(.*)$ serveur/gestion.php?chemin=$1 [QSA,L]
RewriteRule ^api/appli/(.*)$ serveur/appli.php?chemin=$1 [QSA,L]
RewriteRule ^api/site/(.*)$ serveur/site.php?chemin=$1 [QSA,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always unset X-Powered-By
Header unset X-Powered-By
Header always set tdm-reservation "1"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-59Jv0D8l/mrFTCQ2y4C2ljXaNMlkywdbMkQn2Buq5Oo=' 'sha256-IFPr5mKO4iDhqA5WlzGbCHgo1B5z5iQoubSHvfY74wo='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
<FilesMatch "\.woff2$">
Header set Cache-Control "public, max-age=31536000, immutable"
Header unset Expires
</FilesMatch>
<FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|avif)$">
Header set Cache-Control "public, max-age=2592000"
Header unset Expires
</FilesMatch>
<FilesMatch "\.(html?|css|m?js|json|txt|xml|webmanifest)$">
Header set Cache-Control "no-cache"
Header unset Expires
</FilesMatch>
</IfModule>
